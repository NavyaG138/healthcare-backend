            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Meera Iyer\",\n  \"specialization\": \"Cardiology\",\n  \"experience_years\": 13,\n  \"email\": \"meera@hospital.com\",\n  \"phone\": \"9123456780\"\n}"
            }
          }
        },
        {
          "name": "Delete doctor",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
