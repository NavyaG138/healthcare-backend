            "url": {
              "raw": "{{base_url}}/api/mappings/{{patient_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mappings",
                "{{patient_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
